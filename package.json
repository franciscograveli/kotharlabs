  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "embla-carousel": "^8.6.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "wrangler": "4.86.0"
  }
}
