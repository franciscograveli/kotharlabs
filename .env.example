# Variáveis do docker-compose.yml (Coolify: aba Environment Variables). NUNCA versione o .env.
# As do contato-api estão em contato-api/.env.example.

# Medição (Umami)
UMAMI_DB_PASSWORD=          # openssl rand -hex 24 (só letras e números, vai dentro da URL do banco)
UMAMI_APP_SECRET=           # openssl rand -hex 32
# id do site no painel do Umami (Settings → Websites → Edit). Marque como "build time" no Coolify. Vazio = sem medição.
UMAMI_WEBSITE_ID=
