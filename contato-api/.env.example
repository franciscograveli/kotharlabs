# Copie para .env (ou cadastre no painel do Coolify). NUNCA versione o .env.
# SMTP de verdade: use as credenciais do provedor de e-mail do contato@kotharlabs.com.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
# SMTP_SECURE: "true" (TLS direto, normalmente porta 465) ou "false" (STARTTLS, porta 587). Padrão: true só na 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_TO=contato@kotharlabs.com
# remetente do aviso; use um endereço do seu domínio autorizado no provedor (SPF/DKIM)
MAIL_FROM="Site Kothar <site@kotharlabs.com>"
# opcional: segredo do token de tempo (openssl rand -hex 32). Sem ele, nasce a cada restart.
TOKEN_SECRET=
# opcionais (valores padrão)
# MIN_FILL_MS=3000
# RATE_IP_PER_HOUR=5
# RATE_POST_IP_PER_HOUR=30
# RATE_GLOBAL_PER_HOUR=60
