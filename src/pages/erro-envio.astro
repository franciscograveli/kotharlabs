---
import Pagina from '../layouts/Pagina.astro';
import { SITE, mailto } from '../data/site';
---
<Pagina titulo="Não foi desta vez · Kothar Labs">
  <p class="eyebrow">Contato</p>
  <h1 class="h1">Não deu para enviar.</h1>
  <p class="texto">O formulário falhou do nosso lado ou algum campo não passou. Sem problema: escreva direto para <a class="tlink" href={mailto()}>{SITE.email}</a> e respondemos em até 24 horas.</p>
  <a class="tlink" href="/#contato">Voltar ao formulário</a>
</Pagina>
<style>
  .h1{font-family:var(--serif);font-weight:400;font-size:44px;line-height:50px;letter-spacing:-.02em;color:var(--tinta)}
  .texto{font-size:18px;line-height:28px;max-width:540px}
  @media (min-width:761px){
    .h1{font-size:64px;line-height:72px}
  }
</style>
