---
import Pagina from '../layouts/Pagina.astro';
---
<Pagina titulo="Recebido · Kothar Labs">
  <p class="eyebrow">Contato</p>
  <h1 class="h1">Recebido.</h1>
  <p class="texto">Respondemos em até 24 horas, com um próximo passo claro.</p>
  <a class="tlink" href="/">Voltar para o início</a>
</Pagina>
<style>
  .h1{font-family:var(--serif);font-weight:400;font-size:44px;line-height:50px;letter-spacing:-.02em;color:var(--tinta)}
  .texto{font-size:18px;line-height:28px;max-width:540px}
  @media (min-width:761px){
    .h1{font-size:64px;line-height:72px}
  }
</style>
