---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ParaQuem from '../components/ParaQuem.astro';
import Servicos from '../components/Servicos.astro';
import Clientes from '../components/Clientes.astro';
import Como from '../components/Como.astro';
import Oficio from '../components/Oficio.astro';
import Duvidas from '../components/Duvidas.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    <ParaQuem />
    <Servicos />
    <Clientes />
    <Como />
    <Oficio />
    <Duvidas />
    <Contato />
  </main>
  <Footer />
</Base>
