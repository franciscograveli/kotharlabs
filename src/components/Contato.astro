---
import { SITE, mailto, whatsapp } from '../data/site';
---
<section id="contato" class="contato">
  <div class="wrap sec-pad conteudo">
    <div class="esq">
      <span class="eyebrow">Contato</span>
      <h2 class="h2 grande">Conta a ideia.<br />A gente diz se dá.</h2>
      <p class="lead">Escreva em poucas linhas o que você quer construir. Respondemos em até 24 horas, com um próximo passo claro.</p>
      <div class="planb">
        <span class="rotulo">Prefere e-mail?</span>
        <a class="tlink" href={mailto()}>{SITE.email}</a>
        <span class="rotulo segundo">Ou no WhatsApp</span>
        <a class="tlink" href={whatsapp} target="_blank" rel="noopener" data-evento="botao-whatsapp" data-onde="contato">{SITE.whatsapp.exibicao}</a>
      </div>
    </div>
    <div class="dir">
      <form id="form-contato" class="form" method="post" action="/api/contato" data-estado="ocioso">
        <div class="campo">
          <label for="c-nome">Nome</label>
          <input id="c-nome" name="nome" type="text" autocomplete="name" required maxlength="100" aria-describedby="e-nome" />
          <p class="erro" id="e-nome" aria-live="polite"></p>
        </div>
        <div class="campo">
          <label for="c-email">E-mail</label>
          <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="e-email" />
          <p class="erro" id="e-email" aria-live="polite"></p>
        </div>
        <fieldset class="campo cheio" aria-describedby="e-tipo">
          <legend>Você é</legend>
          <div class="opcoes">
            <label class="op"><input type="radio" name="tipo" value="startup" required />Startup</label>
            <label class="op"><input type="radio" name="tipo" value="empresa" required />Empresa</label>
          </div>
          <p class="erro" id="e-tipo" aria-live="polite"></p>
        </fieldset>
        <div class="campo cheio">
          <label for="c-ideia">A ideia</label>
          <textarea id="c-ideia" name="ideia" rows="5" required minlength="10" maxlength="2000" aria-describedby="e-ideia"></textarea>
          <p class="erro" id="e-ideia" aria-live="polite"></p>
        </div>
        <div class="oculto" aria-hidden="true">
          <label>Deixe em branco<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <!-- token de tempo: o nginx troca o comentário SSI abaixo pelo token assinado pelo contato-api -->
        <Fragment set:html={`<input type="hidden" name="t" value="<!--# include virtual='/api/contato/token' -->">`} />
        <div class="rodape cheio">
          <p class="consent">Usamos esses dados só para responder você. <a href="/privacidade">Privacidade</a>.</p>
          <button class="btn btn-primary" type="submit" data-evento="botao-contato" data-onde="formulario">Enviar</button>
        </div>
        <p class="status cheio" role="status" aria-live="polite"></p>
      </form>
      <div class="ok" role="status" tabindex="-1" hidden>
        <p class="h3">Recebido.</p>
        <p>Respondemos em até 24 horas, com um próximo passo claro.</p>
      </div>
    </div>
  </div>
</section>
<script>
  const f = document.querySelector<HTMLFormElement>('#form-contato')!;
  const botao = f.querySelector<HTMLButtonElement>('button')!;
  const status = f.querySelector<HTMLElement>('.status')!;
  const token = f.querySelector<HTMLInputElement>('[name=t]')!;
  const ok = document.querySelector<HTMLElement>('#contato .ok')!;
  const planb = document.querySelector<HTMLAnchorElement>('#contato .planb a')!;
  const mailBase = planb.href;
  const campos = ['nome', 'email', 'tipo', 'ideia'];
  const MSG: Record<string, string> = {
    nome: 'Diga seu nome.',
    email: 'Esse e-mail não parece certo.',
    tipo: 'Escolha Startup ou Empresa.',
    ideia: 'Escreva ao menos uma linha sobre a ideia.',
  };
  const EMAIL = /^[^\s@<>(),;:\\"[\]]{1,64}@[^\s@<>(),;:\\"[\]]+\.[^\s@<>(),;:\\"[\]]{2,}$/;
  f.noValidate = true; // com JS, as mensagens são as nossas

  const estado = (e: 'ocioso' | 'enviando' | 'erro', msg = '') => {
    f.dataset.estado = e;
    botao.disabled = e === 'enviando';
    botao.textContent = e === 'enviando' ? 'Enviando…' : 'Enviar';
    status.textContent = msg;
  };
  const mostrar = (erros: Record<string, string>) => {
    campos.forEach((c) => {
      f.querySelector('#e-' + c)!.textContent = erros[c] || '';
      f.querySelectorAll(`[name=${c}]`).forEach((el) => (erros[c] ? el.setAttribute('aria-invalid', 'true') : el.removeAttribute('aria-invalid')));
    });
    const primeiro = campos.find((c) => erros[c]);
    if (primeiro) f.querySelector<HTMLElement>(`[name=${primeiro}]`)!.focus();
  };
  const validar = (d: FormData) => {
    const e: Record<string, string> = {};
    if (!String(d.get('nome')).trim()) e.nome = MSG.nome;
    if (!EMAIL.test(String(d.get('email')).trim())) e.email = MSG.email;
    if (!d.get('tipo')) e.tipo = MSG.tipo;
    if (String(d.get('ideia')).trim().length < 10) e.ideia = MSG.ideia;
    return e;
  };
  const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const novoToken = async () => {
    token.value = await (await fetch('/api/contato/token')).text();
    await espera(3300);
  };

  f.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const erros = validar(new FormData(f));
    mostrar(erros);
    if (Object.keys(erros).length) return estado('ocioso');
    estado('enviando');
    try {
      // o servidor recusa envio com menos de 3 s desde que a página foi servida
      await espera(Math.max(0, 3300 - performance.now()));
      if (!/^\d+\./.test(token.value)) await novoToken(); // sem SSI (ex.: astro preview)
      for (let tentativa = 0; ; tentativa++) {
        const r = await fetch(f.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(f))),
        });
        const j = await r.json().catch(() => null);
        if (r.ok && j?.ok) {
          f.hidden = true;
          ok.hidden = false;
          ok.focus();
          return;
        }
        if (j?.erros) {
          mostrar(j.erros);
          return estado('ocioso');
        }
        if (tentativa === 0 && ['token', 'rapido', 'expirado'].includes(j?.erro)) {
          await novoToken(); // token vencido: pega outro e tenta uma vez
          continue;
        }
        throw new Error(j?.erro || 'falha');
      }
    } catch {
      // plano B: o e-mail já vem com o texto que a pessoa escreveu
      const d = new FormData(f);
      planb.href = `${mailBase}?subject=${encodeURIComponent('Nova ideia: ' + d.get('nome'))}&body=${encodeURIComponent(String(d.get('ideia')).slice(0, 1500))}`;
      estado('erro', 'Não deu para enviar agora. Seu texto continua aí: tente de novo ou escreva por e-mail.');
    }
  });
</script>
<style>
  .contato{background:var(--linho)}
  .conteudo{display:grid;grid-template-columns:1fr;gap:40px;align-items:start}
  .esq{display:flex;flex-direction:column;gap:24px;min-width:0}
  .eyebrow{margin-bottom:-8px}
  .grande{font-size:38px;line-height:44px}
  .lead{max-width:420px;font-size:18px;line-height:28px;color:var(--tinta)}
  .planb{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding-top:20px;border-top:1px solid var(--fio-claro);font-size:15px;line-height:24px}
  .planb .tlink{font-size:16px;font-weight:400;text-decoration-thickness:1px;text-underline-offset:5px}
  .rotulo{font-family:var(--mono);font-size:12px;line-height:16px;letter-spacing:.14em;text-transform:uppercase;color:var(--pedra)}
  .rotulo.segundo{margin-top:8px}
  .dir{min-width:0}

  .form{display:grid;grid-template-columns:1fr;gap:28px 24px}
  .form[hidden]{display:none} /* o display:grid acima venceria o [hidden] e o form ficaria embaixo do "Recebido." */
  .campo{display:flex;flex-direction:column;gap:10px;min-width:0;margin:0;padding:0;border:0}
  label,legend{padding:0;font-family:var(--mono);font-size:12px;line-height:16px;letter-spacing:.14em;text-transform:uppercase;color:var(--pedra)}
  legend{margin-bottom:10px}

  /* campos afundados (baixo relevo): sem contorno; sombra interna em cima/esquerda, brilho embaixo/direita */
  input[type=text],input[type=email],textarea,.op{background:#E9E2D0;border:0;border-radius:0;box-shadow:inset 1.5px 2px 3px rgba(90,68,36,.38),1px 1.5px 0 rgba(255,255,255,.9)}
  input[type=text],input[type=email],textarea{width:100%;box-sizing:border-box;min-height:48px;padding:12px 16px;color:var(--tinta);font-family:var(--sans);font-size:17px;line-height:24px}
  textarea{resize:vertical;height:128px;min-height:128px}
  input[type=text]:focus-visible,input[type=email]:focus-visible,textarea:focus-visible{outline:2px solid var(--cobre);outline-offset:2px;box-shadow:inset 2px 2.5px 4px rgba(90,68,36,.5),1px 1.5px 0 rgba(255,255,255,.9)}
  [aria-invalid=true]:not(.op input){outline:1px solid var(--cobre-hover);outline-offset:0}
  input[type=text][aria-invalid=true]:focus-visible,input[type=email][aria-invalid=true]:focus-visible,textarea[aria-invalid=true]:focus-visible{outline:2px solid var(--cobre);outline-offset:2px}
  .erro{font-size:14px;line-height:20px;color:var(--cobre-hover)}
  .erro:empty{display:none}

  .opcoes{display:flex;gap:12px;flex-wrap:wrap}
  .op{position:relative;display:inline-flex;align-items:center;gap:10px;min-height:48px;box-sizing:border-box;padding:0 22px;font-family:var(--sans);font-size:16px;line-height:24px;font-weight:500;letter-spacing:0;text-transform:none;color:var(--pedra);cursor:pointer}
  .op input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
  .op:has(input:checked){color:var(--tinta);font-weight:600}
  .op:has(input:checked)::before{content:"";flex:0 0 8px;width:8px;height:8px;border-radius:50%;background:var(--cobre)}
  .op:has(input:focus-visible){outline:2px solid var(--cobre);outline-offset:2px}
  .op:has(input[aria-invalid=true]){outline:1px solid var(--cobre-hover)}
  .op:has(input[aria-invalid=true]:focus-visible){outline:2px solid var(--cobre);outline-offset:2px}

  .oculto{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .rodape{display:flex;flex-direction:column;gap:20px;margin-top:4px}
  .consent{font-size:13px;line-height:20px;color:var(--pedra)}
  .consent a{color:var(--tinta)}
  .btn{height:auto;padding:14px 28px;border:0;border-radius:0;box-shadow:none;cursor:pointer;width:100%;height:52px;padding:0}
  .btn:disabled{background:var(--pedra);cursor:progress}
  .status{font-size:14px;line-height:20px;color:var(--tinta)}
  .form[data-estado=erro] .status{padding-left:12px;border-left:2px solid var(--cobre-hover)}
  .status:empty{display:none}
  .ok{padding:24px 0 24px 20px;border-left:2px solid var(--cobre);display:flex;flex-direction:column;gap:8px}
  .ok[hidden]{display:none}
  .ok:focus{outline:none}

  @media (max-width:899px){
    .conteudo{padding-left:20px;padding-right:20px}
  }
  @media (min-width:900px){
    .conteudo{grid-template-columns:5fr 7fr;gap:80px}
    .grande{font-size:52px;line-height:58px}
    .form{grid-template-columns:1fr 1fr}
    .cheio{grid-column:1 / -1}
    .rodape{flex-direction:row;align-items:center;justify-content:space-between;gap:32px}
    .consent{max-width:420px}
    .btn{width:auto;height:auto;padding:14px 28px;flex:0 0 auto}
  }
</style>
