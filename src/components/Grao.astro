---
// Textura de grão (feTurbulence) por cima do fundo da seção.
interface Props {
  id: string;
  matriz: string;
}
const { id, matriz } = Astro.props;
---
<svg class="grao" aria-hidden="true" focusable="false">
  <filter id={id} x="0" y="0" width="100%" height="100%">
    <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence>
    <feColorMatrix values={matriz}></feColorMatrix>
  </filter>
  <rect width="100%" height="100%" filter={`url(#${id})`}></rect>
</svg>
<style>
  .grao{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}
</style>
